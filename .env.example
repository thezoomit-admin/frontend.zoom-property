# The public origin of this deployment, no trailing slash.
# Feeds metadataBase, every canonical URL, robots.txt and sitemap.xml.
# Leave unset locally and it falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The panel's API (no trailing slash after /api). Must match server PORT.
# Local default: server.zoom-property uses PORT=5009.
API_URL=http://localhost:5009/api
NEXT_PUBLIC_API_URL=http://localhost:5009/api
NEXT_PUBLIC_IMAGE_ACCESS_URL=http://localhost:5009

# Backstop refresh for cached API data, in seconds. Freshness normally comes
# from the panel pinging /api/revalidate on save; this is only insurance for
# a ping that never arrives. Set to `false` to rely on the tags alone.
API_REVALIDATE=60

# Shared with the API's REVALIDATE_SECRET. The panel posts it to
# /api/revalidate after a save so the affected pages rebuild immediately.
# Without it that route refuses every request.
REVALIDATE_SECRET=dev-revalidate-secret

# Optional R2 / CDN public base for media keys.
# NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
