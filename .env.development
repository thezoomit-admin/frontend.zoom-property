# # Backend API used while running `pnpm dev`
# API_URL=http://localhost:5008/api
# NEXT_PUBLIC_API_URL=http://localhost:5008/api
# NEXT_PUBLIC_IMAGE_ACCESS_URL=http://localhost:5008

# # Local frontend URL, used for canonical links and metadata
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# # Development cache/revalidation settings
# API_REVALIDATE=60
# REVALIDATE_SECRET=dev-revalidate-secret

# # Public media bucket
# NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-5b52277bf86041a0b4872bee7a979553.r2.dev



# Public production API
API_URL=https://api.zoompropertyltd.com/api
NEXT_PUBLIC_API_URL=https://api.zoompropertyltd.com/api
NEXT_PUBLIC_IMAGE_ACCESS_URL=https://api.zoompropertyltd.com

# Public production website URL, used for canonical links and metadata
NEXT_PUBLIC_SITE_URL=https://zoompropertyltd.com

# Production cache/revalidation settings
API_REVALIDATE=3600

# Set this secret in the deployment provider. Do not commit its real value.
REVALIDATE_SECRET=

# Public media bucket
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-5b52277bf86041a0b4872bee7a979553.r2.dev
